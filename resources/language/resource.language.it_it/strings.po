msgctxt "#30300"
msgid "Login (device code)"
msgstr "Login (codice dispositivo)"

msgctxt "#30301"
msgid "Go to [B]%s[/B] and enter this code:[CR][CR][B]%s[/B]"
msgstr "Vai su [B]%s[/B] e inserisci questo codice:[CR][CR][B]%s[/B]"

msgctxt "#30302"
msgid "Waiting for authorization..."
msgstr "In attesa di autorizzazione..."

msgctxt "#30303"
msgid "Login successful. The access token will now be refreshed automatically."
msgstr "Accesso effettuato con successo. Il token d'accesso verrà ora aggiornato automaticamente."

msgctxt "#30304"
msgid "Login failed or timed out."
msgstr "Accesso fallito o tempo scaduto."

msgctxt "#30305"
msgid "Login cancelled."
msgstr "Accesso annullato."

msgctxt "#30306"
msgid "Device login is not available for this Client-ID.[CR]Register your own application (Public type) at dev.twitch.tv/console/apps and set its Client-ID in the add-on settings, then try again."
msgstr "Il login tramite dispositivo non è disponibile per questo Client-ID.[CR]Registra la tua applicazione (tipo Pubblica) su dev.twitch.tv/console/apps, imposta il suo Client-ID nelle impostazioni dell'add-on e riprova."

msgctxt "#30307"
msgid "Supported codecs"
msgstr "Codec supportati"

msgctxt "#30308"
msgid "Twitch default"
msgstr "Predefinito di Twitch"

msgctxt "#30309"
msgid "H.265 (HEVC)"
msgstr "H.265 (HEVC)"

msgctxt "#30310"
msgid "Automatic token refresh needs a public Client-ID.[CR]Register your own application (Public type) at dev.twitch.tv/console/apps and set its Client-ID in the add-on settings."
msgstr "L'aggiornamento automatico del token richiede un Client-ID pubblico.[CR]Registra la tua applicazione (tipo Pubblica) su dev.twitch.tv/console/apps e imposta il suo Client-ID nelle impostazioni dell'add-on."

msgctxt "#30311"
msgid "Login: ad-free playback / Turbo (device code)"
msgstr "Login: riproduzione senza pubblicità / Turbo (codice dispositivo)"

msgctxt "#30312"
msgid "Go to [B]%s[/B] with your [B]Turbo/subscriber account[/B] and enter this code:[CR][CR][B]%s[/B]"
msgstr "Vai su [B]%s[/B] con il tuo [B]account Turbo/abbonato[/B] e inserisci questo codice:[CR][CR][B]%s[/B]"

msgctxt "#30313"
msgid "Turbo / ad-free login successful. The token is renewed automatically. Ad-free playback only applies if the logged-in account has Turbo or is subscribed to the channel."
msgstr "Login Turbo / senza pubblicità riuscito. Il token viene rinnovato automaticamente. La riproduzione senza pubblicità si applica solo se l'account connesso ha Turbo o è abbonato al canale."

msgctxt "#30330"
msgid "Search method"
msgstr "Metodo di ricerca"

msgctxt "#30331"
msgid "Website (twitch.tv, fuzzy)"
msgstr "Sito web (twitch.tv, approssimativa)"

msgctxt "#30332"
msgid "Helix API"
msgstr "API Helix"
